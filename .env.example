# TapeFour environment variables
# Copy this to .env and fill in throwaway keys ONLY.
# NEVER commit .env or any real private key.

# X Layer RPC (public endpoint, safe to leave as-is)
XLAYER_RPC_URL=https://rpc.xlayer.tech

# Fork RPC for Hardhat fork tests (usually local Hardhat node)
FORK_RPC_URL=http://127.0.0.1:8545

# Throwaway deployer key (no leading 0x) — used only by scripts/tapeout.ts and scripts/deploy.ts
# Generate with:  node -e "const {randomBytes}=require('crypto');console.log(randomBytes(32).toString('hex'))"
DEPLOYER_KEY=

# Bot operator key (no leading 0x) — used only by bot/operator.ts
# This account submits bot moves on-chain.  It has no power over player funds.
BOT_OPERATOR_KEY=
BOT_OPERATOR_ADDRESS=

# Project treasury address (required — receives 40% protocol share to cover operator gas)
# Must NOT be zero address, and must NOT equal deployer or bot operator address.
TREASURY_ADDRESS=

# Difficulty: easy | medium | hard (default: medium)
BOT_DIFFICULTY=medium

# Filled in by scripts/tapeout.ts after tape-out
PROCESSOR_ADDRESS=
CIRCUIT_ID=

# Filled in by scripts/deploy.ts after contract deploy
TAPEFOUR_ADDRESS=
